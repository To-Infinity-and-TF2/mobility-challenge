<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="arena">
    <static>true</static>
    <link name="arena_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="arena_visual">
        <geometry>
          <mesh>
            <uri>model://arena/a.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="arena_collision">
        <geometry>
          <mesh>
            <uri>model://arena/a.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
